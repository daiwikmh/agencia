# --- Network (CAIP-2) ---
HEDERA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- Blocky402 facilitator (x402 v2, testnet is open — no key) ---
BLOCKY402_URL=https://api.testnet.blocky402.com

# --- Agencia service (the seller) ---
AGENCIA_OPERATOR_ID=0.0.xxxxxxx
AGENCIA_OPERATOR_KEY=
AGENCIA_PAY_TO=
PORT=3022
AGENCIA_HCS_TOPIC_ID=

# --- Pricing (HBAR; settled in tinybar) ---
PRICE_PER_CALL_HBAR=0.05
PRICE_PER_1K_TOKEN_HBAR=0.02

# --- Consuming agent (the buyer) ---
AGENT_ACCOUNT_ID=0.0.xxxxxxx
AGENT_PRIVATE_KEY=
AGENT_BUDGET_HBAR=5
AGENCIA_SERVICE_URL=http://localhost:3022
AGENT_IDENTITY_TOPIC_ID=

# --- Hosted model behind the paid tool ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=openai/gpt-oss-20b

# --- The Graph (optional — only needed to query by bare subgraph id) ---
GRAPH_API_KEY=
GRAPH_GATEWAY_BASE=https://gateway.thegraph.com/api

# --- OpenAI (second inference provider, optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Pricing overrides for infer_openai ---
PRICE_PER_CALL_HBAR_OPENAI=0.03
PRICE_PER_1K_TOKEN_HBAR_OPENAI=0.015
