---
import DashboardRoute from "../../components/dashboard/DashboardRoute.tsx";
import { TABS, SECTIONS, type Tab } from "../../components/dashboard/types.js";

export const prerender = false;

const { tab } = Astro.params;
if (!tab || !TABS.includes(tab as Tab)) {
  return Astro.redirect("/dashboard/catalog");
}
const active = tab as Tab;
const label = SECTIONS.find((s) => s.id === active)?.label ?? "Dashboard";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agencia — {label}</title>
    <link rel="icon" href="/logo.png" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #e8e8ea;
      }
    </style>
  </head>
  <body>
    <DashboardRoute client:load tab={active} />
  </body>
</html>
