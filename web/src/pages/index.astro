---
const HERO_GIF_URL = "/hero-glow.gif";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Agencia — Connect your agent to every service it needs</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #111417;
        --muted: #6b7178;
        --bg: #ffffff;
        --radius-card: 26px;
        --pad: clamp(20px, 2.2vw, 34px);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
        --stagger: 72ms;
        --nature-img: url("/hero-glow.gif");
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
      }
      body.nav-open {
        overflow: hidden;
      }
      img,
      video {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
      }

      /* ---------- 3. LAYOUT SHELL ---------- */
      .hero {
        position: relative;
        height: 100vh;
        height: 100svh;
        min-height: 600px;
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
        gap: clamp(16px, 2.4vw, 40px);
        padding: var(--pad);
        padding-left: max(var(--pad), env(safe-area-inset-left));
        padding-right: max(var(--pad), env(safe-area-inset-right));
        overflow: hidden;
      }

      .hero__left {
        position: relative;
        order: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding-left: clamp(4px, 1.6vw, 28px);
      }
      .hero__media {
        order: 2;
      }

      /* ---------- 4a. NAV ROW ---------- */
      .nav {
        display: flex;
        align-items: center;
        gap: clamp(20px, 3.4vw, 58px);
        padding-top: clamp(4px, 0.6vw, 10px);
      }
      .brand {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
        flex: 0 0 auto;
        min-width: 0;
      }
      .brand__mark {
        height: clamp(19px, 1.5vw, 25px);
        width: auto;
        margin-right: clamp(8px, 0.7vw, 11px);
      }
      .brand__name {
        font-weight: 700;
        letter-spacing: 0.06em;
        font-size: clamp(14px, 1.15vw, 19px);
        text-transform: uppercase;
        white-space: nowrap;
      }
      .nav__links {
        display: flex;
        align-items: center;
        gap: clamp(16px, 2.3vw, 42px);
        margin: 0 auto 0 clamp(10px, 2vw, 44px);
        padding: 0;
        list-style: none;
      }
      .nav__links a {
        text-decoration: none;
        color: var(--ink);
        font-size: clamp(14px, 1.02vw, 17px);
        font-weight: 500;
        opacity: 0.88;
        transition: opacity 0.2s ease;
      }
      .nav__links a:hover {
        opacity: 1;
      }

      .burger {
        appearance: none;
        border: 0;
        background: transparent;
        color: inherit;
        padding: 8px 0 8px 8px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        flex: 0 0 auto;
        margin-left: auto;
        position: relative;
        z-index: 70;
        height: 30px;
        transition: color 0.35s ease;
      }
      .burger span {
        display: block;
        width: 30px;
        height: 2.5px;
        border-radius: 2px;
        background: currentColor;
        transform-origin: center;
        transition: transform 0.55s var(--ease-out), opacity 0.25s ease,
          width 0.45s var(--ease-out);
      }
      .burger:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 6px;
        border-radius: 4px;
      }
      .burger:hover span:nth-child(2) {
        width: 22px;
      }
      .burger.is-active span:nth-child(1) {
        transform: translateY(8.5px) rotate(45deg);
      }
      .burger.is-active span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0.2);
      }
      .burger.is-active span:nth-child(3) {
        transform: translateY(-8.5px) rotate(-45deg);
      }
      .burger.is-active:hover span:nth-child(2) {
        width: 30px;
      }
      .burger.is-active {
        color: var(--ink);
      }
      .burger.is-active.burger--on-panel {
        color: #fff;
      }

      /* ---------- 4b. CONTENT BLOCK ---------- */
      .hero__content {
        margin-top: auto;
        padding: clamp(24px, 4vh, 60px) 0;
        max-width: 820px;
      }
      .hero__title {
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.022em;
        line-height: 1.1;
        font-size: clamp(2.15rem, 3.85vw, 4.1rem);
      }
      .hero__line {
        display: block;
      }
      .hl {
        display: inline-block;
        color: #fff;
        padding: 0.06em 0.2em 0.14em;
        margin: 0 0.04em;
        border-radius: 16px;
        background-image: linear-gradient(rgba(6, 8, 12, 0.52), rgba(6, 8, 12, 0.52)),
          var(--nature-img);
        background-size: cover;
        background-position: 50% 42%;
        background-repeat: no-repeat;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }
      .hero__text {
        margin: clamp(22px, 3.2vh, 42px) 0 0;
        max-width: 47ch;
        color: var(--muted);
        font-size: clamp(14px, 1.02vw, 17px);
        line-height: 1.95;
      }
      .cta {
        display: inline-flex;
        align-items: center;
        gap: clamp(14px, 1.5vw, 24px);
        margin-top: clamp(28px, 5vh, 66px);
        text-decoration: none;
        color: inherit;
      }
      .cta__label {
        font-size: clamp(15px, 1.1vw, 19px);
        font-weight: 500;
      }
      .cta__icon {
        width: clamp(44px, 3.6vw, 58px);
        height: clamp(44px, 3.6vw, 58px);
        border-radius: 50%;
        border: 1.5px solid rgba(17, 20, 23, 0.55);
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
      }
      .cta__icon svg {
        width: 44%;
        height: 44%;
      }
      .cta:hover .cta__icon {
        background: var(--ink);
        color: #fff;
        transform: translateX(4px);
      }

      .socials--mobile {
        display: none;
      }

      /* ---------- 5. MEDIA CARD ---------- */
      .hero__media {
        position: relative;
        isolation: isolate;
        border-radius: var(--radius-card);
        overflow: hidden;
        background: #0b2a3a;
        min-width: 0;
      }
      .hero__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero__media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0) 38%);
        pointer-events: none;
      }

      .marker {
        position: absolute;
        z-index: 3;
        --dot-r: 17px;
      }
      .marker__dot {
        position: absolute;
        left: calc(var(--dot-r) * -1);
        top: calc(var(--dot-r) * -1);
        width: calc(var(--dot-r) * 2);
        height: calc(var(--dot-r) * 2);
        border: 4px solid #fff;
        border-radius: 50%;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
      }
      .marker__line {
        position: absolute;
        left: 0;
        top: -1.5px;
        width: 60px;
        height: 3px;
        background: #fff;
        border-radius: 2px;
        transform-origin: 0 50%;
        transform: rotate(212deg);
        clip-path: inset(0 0 0 var(--dot-r));
      }
      .marker__label {
        position: absolute;
        right: 50px;
        bottom: 28px;
        white-space: nowrap;
        background: #fff;
        color: var(--ink);
        font-size: clamp(13px, 0.95vw, 16px);
        font-weight: 500;
        padding: 0.62em 1.05em;
        border-radius: 999px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.16);
      }
      .marker--water {
        left: 56%;
        top: 26%;
      }
      .marker--reef {
        left: 59%;
        top: 59%;
      }
      .marker--right .marker__line {
        transform: rotate(-32deg);
      }
      .marker--right .marker__label {
        right: auto;
        left: 50px;
      }

      .socials {
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: clamp(18px, 2.2vw, 38px);
        background: #fff;
        padding: clamp(14px, 1.5vw, 24px) clamp(20px, 2.2vw, 38px);
        border-top-left-radius: 36px;
        border-bottom-right-radius: var(--radius-card);
      }
      .socials a {
        color: var(--ink);
        display: grid;
        place-items: center;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .socials a:hover {
        opacity: 0.65;
        transform: translateY(-2px);
      }
      .socials svg {
        width: clamp(20px, 1.5vw, 26px);
        height: clamp(20px, 1.5vw, 26px);
      }

      /* ---------- 6. SLIDE-IN NAV SHEET ---------- */
      .navsheet {
        position: fixed;
        inset: 0;
        z-index: 60;
        visibility: hidden;
        transition: visibility 0s linear 0.46s;
      }
      .navsheet.is-open {
        visibility: visible;
        transition: visibility 0s linear 0s;
      }
      .navsheet__scrim {
        position: absolute;
        inset: 0;
        background: rgba(5, 17, 24, 0.45);
        opacity: 0;
        -webkit-backdrop-filter: blur(0px);
        backdrop-filter: blur(0px);
        transition: opacity 0.32s ease, backdrop-filter 0.32s ease,
          -webkit-backdrop-filter 0.32s ease;
      }
      .navsheet.is-open .navsheet__scrim {
        opacity: 1;
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        transition: opacity 0.5s ease, backdrop-filter 0.6s ease,
          -webkit-backdrop-filter 0.6s ease;
      }
      .navsheet__panel {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(100%, 460px);
        display: flex;
        flex-direction: column;
        padding: calc(var(--pad) + 78px) clamp(24px, 6vw, 52px) calc(var(--pad) + 12px);
        padding-bottom: max(calc(var(--pad) + 12px), env(safe-area-inset-bottom));
        background: rgba(6, 22, 31, 0.9);
        -webkit-backdrop-filter: blur(26px) saturate(150%);
        backdrop-filter: blur(26px) saturate(150%);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: -30px 0 80px rgba(0, 0, 0, 0.35);
        color: #fff;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        transform: translateX(100%);
        transition: transform 0.44s var(--ease-in);
      }
      .navsheet.is-open .navsheet__panel {
        transform: translateX(0);
        transition: transform 0.68s var(--ease-out);
      }
      .navsheet__list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .navsheet__list li {
        border-top: 1px solid rgba(255, 255, 255, 0.13);
      }
      .navsheet__list li:last-child {
        border-bottom: 1px solid rgba(255, 255, 255, 0.13);
      }
      .navsheet__link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: clamp(15px, 2.4vh, 22px) 2px;
        text-decoration: none;
        color: #fff;
        font-size: clamp(1.6rem, 7vw, 2.35rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.1;
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.16s ease, transform 0.16s ease, color 0.25s ease;
      }
      .navsheet.is-open .navsheet__link {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out),
          color 0.25s ease;
        transition-delay: calc(0.16s + var(--i) * 0.062s),
          calc(0.16s + var(--i) * 0.062s), 0s;
      }
      .navsheet__link svg {
        width: 22px;
        height: 22px;
        flex: 0 0 auto;
        opacity: 0;
        transform: translateX(-10px);
        transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
      }
      .navsheet__link:hover,
      .navsheet__link:focus-visible {
        color: #7fd7f2;
      }
      .navsheet__link:hover svg,
      .navsheet__link:focus-visible svg {
        opacity: 1;
        transform: translateX(0);
      }
      .navsheet__link:focus-visible {
        outline: none;
        text-decoration: underline;
        text-underline-offset: 8px;
      }
      .navsheet__foot {
        margin-top: auto;
        padding-top: clamp(26px, 5vh, 48px);
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.16s ease, transform 0.16s ease;
      }
      .navsheet.is-open .navsheet__foot {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
        transition-delay: 0.42s;
      }
      .navsheet__cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 24px;
        border-radius: 999px;
        background: #fff;
        color: #0a1a24;
        font-weight: 600;
        font-size: 16px;
        text-decoration: none;
        transition: transform 0.25s var(--ease-out), background 0.25s ease;
      }
      .navsheet__cta:hover {
        transform: translateY(-2px);
        background: #e8f6fc;
      }
      .navsheet__cta svg {
        width: 16px;
        height: 16px;
      }
      .navsheet__socials {
        display: flex;
        align-items: center;
        gap: 26px;
        margin-top: clamp(22px, 4vh, 34px);
      }
      .navsheet__socials a {
        color: rgba(255, 255, 255, 0.72);
        display: grid;
        place-items: center;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .navsheet__socials a:hover {
        color: #fff;
        transform: translateY(-2px);
      }
      .navsheet__socials svg {
        width: 22px;
        height: 22px;
      }

      /* ---------- 7. PAGE ENTRANCE ANIMATION ---------- */
      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translate3d(0, 18px, 0);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }
      @keyframes media-in {
        from {
          opacity: 0;
          transform: translate3d(28px, 0, 0);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }
      @keyframes video-in {
        from {
          opacity: 0;
          transform: scale(1.06);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      @keyframes pop-in {
        from {
          opacity: 0;
          transform: scale(0.72);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      @keyframes draw-line {
        from {
          opacity: 0;
          transform: rotate(212deg) scaleX(0);
        }
        to {
          opacity: 1;
          transform: rotate(212deg) scaleX(1);
        }
      }
      @keyframes draw-line-right {
        from {
          opacity: 0;
          transform: rotate(-32deg) scaleX(0);
        }
        to {
          opacity: 1;
          transform: rotate(-32deg) scaleX(1);
        }
      }
      .anim {
        animation: fade-up 0.82s var(--ease-out) backwards;
        animation-delay: calc(var(--d, 0) * var(--stagger));
      }
      .hero__media.anim {
        animation-name: media-in;
        animation-duration: 1.05s;
      }
      .hero__video.anim {
        animation-name: video-in;
        animation-duration: 1.35s;
      }
      .marker__dot.anim {
        animation-name: pop-in;
        animation-duration: 0.62s;
      }
      .marker__label.anim {
        animation-duration: 0.7s;
      }
      .marker__line.anim {
        animation-name: draw-line;
        animation-duration: 0.55s;
      }
      .marker--right .marker__line.anim {
        animation-name: draw-line-right;
      }

      /* ---------- 8. RESPONSIVE ---------- */
      @media (max-width: 1180px) {
        .nav__links {
          gap: 20px;
          margin-left: 22px;
        }
        .hero__text {
          line-height: 1.8;
        }
      }
      @media (max-width: 1024px) {
        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
        }
        .nav__links {
          display: none;
        }
        .marker--water {
          left: 46%;
          top: 24%;
        }
        .marker--reef {
          left: 50%;
          top: 60%;
        }
        .marker__line {
          width: 44px;
        }
        .marker {
          --dot-r: 13px;
        }
        .marker__dot {
          border-width: 3px;
        }
        .marker__label {
          font-size: 12px;
          right: 36px;
          bottom: 22px;
        }
        .marker--right .marker__label {
          right: auto;
          left: 36px;
        }
      }
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
        }
        .hero__text {
          max-width: 42ch;
        }
        .marker--water {
          left: 40%;
          top: 22%;
        }
        .marker--reef {
          left: 44%;
          top: 62%;
        }
      }
      @media (max-width: 768px) {
        :root {
          --pad: 20px;
        }
        .hero {
          display: block;
          padding: 0;
          color: #fff;
        }
        .hero__media {
          position: absolute;
          inset: 0;
          border-radius: 0;
        }
        .hero__media::after {
          background: linear-gradient(
            180deg,
            rgba(4, 18, 28, 0.74) 0%,
            rgba(4, 18, 28, 0.5) 42%,
            rgba(4, 18, 28, 0.88) 100%
          );
        }
        .marker,
        .socials {
          display: none;
        }
        .hero__left {
          height: 100%;
          padding: var(--pad);
          padding-top: max(var(--pad), env(safe-area-inset-top));
          padding-bottom: max(var(--pad), env(safe-area-inset-bottom));
          color: #fff;
        }
        .hero__content {
          padding: clamp(20px, 3vh, 40px) 0;
        }
        .hero__title {
          font-size: clamp(2rem, 9.2vw, 3rem);
          line-height: 1.14;
        }
        .hl {
          border-radius: 12px;
        }
        .hero__text {
          color: rgba(255, 255, 255, 0.82);
          max-width: 38ch;
          line-height: 1.75;
          font-size: 15px;
        }
        .cta {
          color: #fff;
          margin-top: 32px;
        }
        .cta__icon {
          border-color: rgba(255, 255, 255, 0.6);
        }
        .cta:hover .cta__icon {
          background: #fff;
          color: var(--ink);
        }
        .socials--mobile {
          display: flex;
          position: static;
          background: transparent;
          padding: 0;
          margin-top: 34px;
          gap: 26px;
          border-radius: 0;
          z-index: auto;
        }
        .socials--mobile a {
          color: #fff;
        }
        .socials--mobile svg {
          width: 22px;
          height: 22px;
        }
      }
      @media (max-width: 420px) {
        .hero__title {
          font-size: clamp(1.8rem, 8.6vw, 2.4rem);
        }
        .hero__text {
          font-size: 14px;
          line-height: 1.7;
        }
        .cta {
          margin-top: 26px;
        }
        .socials--mobile {
          margin-top: 26px;
        }
      }
      @media (max-width: 360px) {
        :root {
          --pad: 16px;
        }
        .brand__name {
          font-size: 13px;
          letter-spacing: 0.05em;
        }
        .burger span {
          width: 26px;
        }
        .hero__text {
          max-width: none;
        }
      }
      @media (max-height: 620px) {
        .hero {
          min-height: 0;
        }
      }
      @media (max-width: 1024px) and (orientation: landscape) and (max-height: 540px) {
        .hero__content {
          padding: 10px 0;
          margin-top: auto;
        }
        .hero__title {
          font-size: clamp(1.5rem, 6.2vh, 2.1rem);
          line-height: 1.12;
        }
        .hero__text {
          font-size: 13px;
          line-height: 1.6;
          max-width: 56ch;
          margin-top: 12px;
        }
        .cta {
          margin-top: 16px;
          gap: 12px;
        }
        .cta__icon {
          width: 38px;
          height: 38px;
        }
        .cta__label {
          font-size: 14px;
        }
        .socials--mobile {
          margin-top: 16px;
          gap: 22px;
        }
        .socials--mobile svg {
          width: 18px;
          height: 18px;
        }
        .navsheet__panel {
          padding-top: calc(var(--pad) + 64px);
        }
        .navsheet__link {
          font-size: clamp(1.15rem, 4.6vh, 1.5rem);
          padding: 10px 2px;
        }
        .navsheet__foot {
          padding-top: 18px;
        }
        .navsheet__socials {
          margin-top: 14px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
          transition-delay: 0s !important;
        }
        .anim {
          animation: none !important;
          opacity: 1 !important;
        }
        .navsheet__link,
        .navsheet__foot {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <section class="hero">
      <div class="hero__media anim" style="--d:0">
        <img class="hero__video anim" style="--d:1" src={HERO_GIF_URL} alt="" />

        <div class="marker marker--water">
          <span class="marker__line anim" style="--d:14"></span>
          <span class="marker__dot anim" style="--d:13"></span>
          <span class="marker__label anim" style="--d:15">Sub-second finality</span>
        </div>
        <div class="marker marker--reef marker--right">
          <span class="marker__line anim" style="--d:17"></span>
          <span class="marker__dot anim" style="--d:16"></span>
          <span class="marker__label anim" style="--d:18">Sub-cent fees</span>
        </div>

        <div class="socials anim" style="--d:19">
          <a href="https://github.com/daiwikmh/agencia" aria-label="GitHub" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div class="hero__left">
        <nav class="nav" aria-label="Primary">
          <a class="brand" href="#"
            ><img class="brand__mark anim" style="--d:2" src="/logo.png" alt="" /><span
              class="brand__name anim"
              style="--d:2">Agencia</span
            ></a
          >
          <ul class="nav__links">
            <li class="anim" style="--d:4"><a href="#service">Service</a></li>
            <li class="anim" style="--d:5"><a href="#pricing">Pricing</a></li>
            <li class="anim" style="--d:6"><a href="#agents">Agents</a></li>
            <li class="anim" style="--d:7"><a href="/dashboard">Dashboard</a></li>
          </ul>
          <button
            class="burger anim"
            style="--d:8"
            id="navToggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="navSheet"
          >
            <span></span><span></span><span></span>
          </button>
        </nav>

        <div class="hero__content">
          <h1 class="hero__title">
            <span class="hero__line anim" style="--d:9"
              >Connect your agent to every</span
            >
            <span class="hero__line anim" style="--d:10"
              ><span class="hl">service</span> it needs</span
            >
          </h1>
          <p class="hero__text anim" style="--d:11">
            A catalog of x402-gated services on Hedera &mdash; inference, on-chain data, price
            feeds and <strong>hardware you rent by the second</strong> &mdash; and the agent that
            consumes them. It discovers an endpoint, pays per call in HBAR through Blocky402, and
            gets its answer. No API key, no subscription, no invoice at the month&rsquo;s end &mdash;
            an agent arrives with a Hedera keypair and nothing else. Suppliers plug their own
            machines in and get paid on the same rail. Sub-second finality, sub-cent fees, every
            payment receipted on the ledger.
          </p>
          <a class="cta" href="/dashboard">
            <span class="cta__label anim" style="--d:12">Open the dashboard</span>
            <span class="cta__icon anim" style="--d:13">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>

          <div class="socials socials--mobile">
            <a href="https://github.com/daiwikmh/agencia" aria-label="GitHub" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="anim" style="--d:14"
                ><path
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="navsheet" id="navSheet" inert>
      <div class="navsheet__scrim" data-nav-close></div>
      <nav class="navsheet__panel" aria-label="Menu">
        <ul class="navsheet__list">
          <li style="--i:0">
            <a class="navsheet__link" href="#service"
              >Service
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </li>
          <li style="--i:1">
            <a class="navsheet__link" href="#pricing"
              >Pricing
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </li>
          <li style="--i:2">
            <a class="navsheet__link" href="#agents"
              >Agents
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </li>
          <li style="--i:3">
            <a class="navsheet__link" href="/dashboard"
              >Dashboard
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </li>
        </ul>
        <div class="navsheet__foot">
          <a class="navsheet__cta" href="/dashboard"
            >Open the dashboard
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <div class="navsheet__socials">
            <a href="https://github.com/daiwikmh/agencia" aria-label="GitHub" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </nav>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById("navToggle");
        var sheet = document.getElementById("navSheet");
        var panel = sheet ? sheet.querySelector(".navsheet__panel") : null;
        if (!btn || !sheet || !panel) return;

        var isOpen = false;

        function syncBurgerContrast() {
          var panelLeft = window.innerWidth - panel.getBoundingClientRect().width;
          var onPanel = btn.getBoundingClientRect().right > panelLeft + 4;
          btn.classList.toggle("burger--on-panel", onPanel);
        }

        function setOpen(next) {
          if (next === isOpen) return;
          isOpen = next;
          if (isOpen) syncBurgerContrast();
          sheet.classList.toggle("is-open", isOpen);
          btn.classList.toggle("is-active", isOpen);
          document.body.classList.toggle("nav-open", isOpen);
          btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
          btn.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
          if (isOpen) {
            sheet.removeAttribute("inert");
          } else {
            sheet.setAttribute("inert", "");
          }
        }

        btn.addEventListener("click", function () {
          setOpen(!isOpen);
        });

        sheet.addEventListener("click", function (e) {
          var t = e.target;
          if (t && t.hasAttribute && t.hasAttribute("data-nav-close")) {
            setOpen(false);
            return;
          }
          if (t && t.closest && t.closest("a")) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", function (e) {
          if ((e.key === "Escape" || e.key === "Esc") && isOpen) {
            setOpen(false);
            btn.focus();
          }
        });

        window.addEventListener("resize", function () {
          if (isOpen) syncBurgerContrast();
        });
      })();
    </script>
  </body>
</html>
